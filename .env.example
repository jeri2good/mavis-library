# Server settings for Netlify Functions. Set real values in Netlify
# (Project configuration → Environment variables, plain values, default scopes),
# or in a local .env for `netlify dev`. Never commit real values.
# Everything is optional: without them, Mavis runs in guest mode with
# device-only storage and no paid features.

# Accounts, sync, and book clubs (stored in Netlify Blobs). A long random string.
# AUTH_SECRET=

# Required before any paid feature answers. Enter the same code in the app's Settings.
# MAVIS_ACCESS_CODE=

# Cloud voice, voice library, and voice copies:
# TTS_PROVIDER=fish            # fish | google
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_VOICE_ID=         # optional default voice
# FISH_AUDIO_MODEL=            # optional
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=            # optional

# AI: Ask Mavis, reading companion, word explanations, discussion questions:
# LLM_PROVIDER=openai          # anthropic | openai (any OpenAI-compatible API)
# LLM_API_KEY=
# LLM_MODEL=                   # optional
# LLM_BASE_URL=                # optional, for OpenAI-compatible providers
# LLM_REASONING_EFFORT=        # optional
# Pictures (OpenAI Responses API), all optional:
# IMAGE_MODEL=
# IMAGE_LLM_MODEL=
# IMAGE_QUALITY=

# Jev ranking of "Picked for you" (TypeSafe key preferred; Eden AI also works):
# TYPESAFE_API_KEY=
# EDENAI_API_KEY=
# JEV_MODEL=                   # optional

# Optional higher Google Books quota for cover lookups:
# GOOGLE_BOOKS_API_KEY=

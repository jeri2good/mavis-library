# Copy to .env (never commit real values). All are optional: without the
# Supabase pair, Mavis runs in guest mode with device-only storage.

# Supabase project URL and *public* anon key (safe in the browser; data is
# protected by row-level security). Used at build time by Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to "true" only after enabling the Google provider in Supabase Auth.
VITE_AUTH_GOOGLE=

# Server-side (Netlify Functions) — optional overrides.
# GUTENDEX_BASE=https://gutendex.com
# GUTENBERG_MIRROR=https://your-gutenberg-mirror.example   # must serve /cache/epub/<id>/...

# ---- Optional paid features (server-side only; set in Netlify, never in the app) ----
# Required before any paid feature answers. Enter the same code in the app's Settings.
# MAVIS_ACCESS_CODE=
# Cloud voice for screen-off / car listening (pick one):
# TTS_PROVIDER=fish            # fish | google
# FISH_AUDIO_API_KEY=
# FISH_AUDIO_VOICE_ID=         # optional voice model id from fish.audio
# FISH_AUDIO_MODEL=            # optional, e.g. s1
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=en-US-Neural2-D
# Ask Mavis (AI reading assistant):
# LLM_PROVIDER=anthropic       # anthropic | openai (any OpenAI-compatible API)
# LLM_API_KEY=
# LLM_MODEL=                   # optional; defaults: claude-haiku-5-5 / gpt-4o-mini
# LLM_BASE_URL=                # optional for OpenAI-compatible providers
# Jev re-ranking of "Picked for you" (TypeSafe key preferred; Eden AI also works):
# TYPESAFE_API_KEY=
# EDENAI_API_KEY=
# Optional higher Google Books quota for cover lookups:
# GOOGLE_BOOKS_API_KEY=

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_paper_background">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_podcast_preview_heading"
        android:textSize="11sp"
        android:textColor="#7A3E1D" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_podcast_preview_title"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#2A211A" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_podcast_preview_detail"
        android:textSize="11sp"
        android:textColor="#51463A" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView style="@style/WidgetAction" android:visibility="visible" android:text="@string/widget_action_play" />
        <TextView style="@style/WidgetAction" android:visibility="visible" android:text="@string/widget_action_new_podcast" />
    </LinearLayout>
</LinearLayout>

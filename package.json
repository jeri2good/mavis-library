{
  "name": "mavis-library",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Mavis Library — a calm, installable reading app for Android tablets, phones, and desktop browsers.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "vite build --mode android --outDir dist-android",
    "preview": "vite preview --port 4173",
    "test:functions": "node tests/functions/functions.test.mjs && node tests/functions/accounts.test.mjs && node tests/functions/groups.test.mjs && node tests/functions/cors.test.mjs && node tests/functions/report.test.mjs && node tests/unit/vocab.test.mjs",
    "test:e2e": "python3 tests/e2e/run_e2e.py",
    "build:bible": "node scripts/build-bible.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.2.6",
    "@fontsource-variable/fraunces": "5.2.8",
    "@fontsource-variable/literata": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.8",
    "@netlify/blobs": "11.1.4",
    "epubjs": "0.3.93",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "8.3.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}

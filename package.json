{
  "name": "mavis-library",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Mavis Library \u2014 a calm, installable reading app for Android tablets, phones, and desktop browsers.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test:functions": "node tests/functions/functions.test.mjs && node tests/functions/accounts.test.mjs",
    "test:e2e": "python3 tests/e2e/run_e2e.py",
    "build:bible": "node scripts/build-bible.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.2.6",
    "@fontsource-variable/fraunces": "5.2.8",
    "@fontsource-variable/literata": "5.2.8",
    "@fontsource-variable/source-serif-4": "5.2.8",
    "@netlify/blobs": "11.1.4",
    "epubjs": "0.3.93",
    "jszip": "3.10.2"
  },
  "devDependencies": {
    "vite": "8.3.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  }
}
